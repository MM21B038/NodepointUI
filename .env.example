# Local dev (recommended): leave both unset — Vite proxies /api and /ws to :8000
#
# Direct API (no proxy): set both to the same host
# VITE_API_BASE_URL=http://localhost:8000/api
# VITE_WS_BASE_URL=ws://localhost:8000
#
# Production:
# VITE_API_BASE_URL=https://your-host.example/api
# VITE_WS_BASE_URL=wss://your-host.example
#
# Set to false to hide the warning on admin signup when the server blocks it
# VITE_ALLOW_ADMIN_SIGNUP=false
